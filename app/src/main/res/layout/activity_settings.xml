<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context=".SettingsActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface_dark"
        app:title="@string/app_name"
        app:titleTextColor="#FFFFFF" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_dark"
        app:tabTextColor="#80FFFFFF"
        app:tabSelectedTextColor="#FFFFFF"
        app:tabIndicatorColor="#2196F3"
        app:tabMode="fixed">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_transfer" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tab_viewer" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TAB 1: CONTROLS & STATUS -->
        <ScrollView
            android:id="@+id/controlsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Main Toggle Button -->
                    <Button
                        android:id="@+id/startStopButton"
                        android:layout_width="0dp"
                        android:layout_height="64dp"
                        android:text="@string/btn_start"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        app:backgroundTint="@color/toggle_start"
                        app:cornerRadius="12dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_percent="0.65" />

                    <!-- Reset Section -->
                    <TextView
                        android:id="@+id/resetLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_reset"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/startStopButton" />

                    <Button
                        android:id="@+id/clrCount"
                        style="?attr/materialButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/btn_stat"
                        android:textSize="12sp"
                        app:backgroundTint="@android:color/holo_red_dark"
                        app:layout_constraintEnd_toStartOf="@+id/clrToken"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/resetLabel" />

                    <Button
                        android:id="@+id/clrToken"
                        style="?attr/materialButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/btn_token"
                        android:textSize="12sp"
                        app:backgroundTint="@android:color/holo_red_dark"
                        app:layout_constraintBottom_toBottomOf="@+id/clrCount"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="0.5"
                        app:layout_constraintStart_toEndOf="@+id/clrCount"
                        app:layout_constraintTop_toTopOf="@+id/clrCount" />

                    <!-- Functions Section -->
                    <TextView
                        android:id="@+id/functionsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_functions"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/clrCount" />

                    <Button
                        android:id="@+id/sleepButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:text="@string/btn_no_sleep"
                        app:layout_constraintEnd_toStartOf="@+id/albumButton"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/functionsLabel"
                        app:layout_constraintWidth_percent="0.4" />

                    <Button
                        android:id="@+id/albumButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="@string/btn_album"
                        app:layout_constraintBottom_toBottomOf="@+id/sleepButton"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/sleepButton"
                        app:layout_constraintTop_toTopOf="@+id/sleepButton"
                        app:layout_constraintWidth_percent="0.4" />

                    <Button
                        android:id="@+id/injectButton"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/btn_inject"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/sleepButton" />

                    <!-- Network Section -->
                    <TextView
                        android:id="@+id/networkLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/label_network"
                        android:textColor="#B0B0B0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/injectButton" />

                    <Button
                        android:id="@+id/connectWifiButton"
                        style="?attr/materialButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/btn_connect_wifi"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        app:backgroundTint="@color/purple_500"
                        app:cornerRadius="8dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/networkLabel"
                        app:layout_constraintWidth_percent="0.65" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- Status fields -->
                <TextView
                    android:id="@+id/statusTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:visibility="gone"
                    tools:text="Status: Waiting..."
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/lastDownloadResultTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:visibility="gone"
                    tools:text="Last download: SUCCESS"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/fileNameInProcess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:visibility="visible"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:text="@string/status_idle" />

                <TextView
                    android:id="@+id/fileTransferSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textColor="#2196F3"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    android:textAppearance="?attr/textAppearanceHeadline6"
                    android:text="@string/speed_idle" />

                <TextView
                    android:id="@+id/fileProgressPercentage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Progress: 45%"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/totalFilesDownloadedTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody1"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="Total downloaded: 123"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/lastDownloadDurationTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:visibility="gone"
                    tools:text="Last transfer time: 1.50 sec"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/pendingCameraFilesTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBody2"
                    android:textColor="@android:color/holo_blue_dark"
                    android:visibility="gone"
                    tools:text="Remaining on camera: 10"
                    tools:visibility="visible" />
            </LinearLayout>
        </ScrollView>

        <!-- TAB 2: REMOTE VIEWER -->
        <LinearLayout
            android:id="@+id/viewerLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <!-- Selection and Action Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <Button
                    android:id="@+id/btnSelectAll"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_select_all"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnDeleteSelected"
                    style="?attr/materialButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_delete_selected"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    app:backgroundTint="@android:color/holo_red_dark" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/viewerProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyViewerTextView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="@string/msg_no_remote_files"
                android:textColor="#B0B0B0"
                android:textSize="16sp"
                android:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/remoteFilesRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </LinearLayout>

    </FrameLayout>
</LinearLayout>
